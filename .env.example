# Copy this file to .env.local and fill in the values. .env.local is ignored by git.
# Firebase console > Project settings > Your apps > Web app > SDK setup and configuration.
# These identify the project; they are not secrets. App Check protects the project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# reCAPTCHA v3 SITE key (free): https://www.google.com/recaptcha/admin/create . Register it in Firebase App Check.
VITE_RECAPTCHA_SITE_KEY=

# Local development only. SECRET: never commit, never paste into chat.
# Set to "true" on the first run, copy the token the browser console prints,
# register it in Firebase console > App Check > Apps > Manage debug tokens, then paste it here.
VITE_APPCHECK_DEBUG_TOKEN=

# Optional model overrides (defaults: gemini-3.5-flash-lite).
VITE_CLOUD_MODEL=
VITE_GROUNDED_MODEL=

# Google Search grounding needs the paid Blaze plan. Keep false on the free Spark plan.
VITE_ENABLE_GROUNDING=false
